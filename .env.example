# Existing Neon credentials belong in ignored .env.local (or .env).
# DATABASE_URL is pooled; DATABASE_URL_UNPOOLED is direct. Both require TLS.
# Do not reprovision the existing project. Keep credentials on the server.
# Add these local application settings to the same ignored file.
VITE_BACKEND_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
PORT=8000

# Existing shared demo authentication. Normal Auth0 sign-in can be configured
# with the package .env.example files instead; set both demo flags false.
DEMO_MODE=true
VITE_DEMO_MODE=true
