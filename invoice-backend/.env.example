#NODE_ENV=production
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# These are local environment variables that are used to connect to the database
# They are listed her as an example and should be replaced with your own values
# They work as default values for the Docker Compose files

# DB connection strings
DATABASE_URL=postgresql://postgres:example@db-dev:5432/db-dev
DEMO_DATABASE_URL=postgresql://postgres:example@db-demo:5432/db-demo

# TODO - verify if this is still needed or an artifiact of old authentication system
SECRET=theSecretStuff

# Demo mode tokens (set these to secure random values in production)
DEMO_USER_TOKEN=demo-token
DEMO_ADMIN_TOKEN=demo-token-admin

# Optional ENV - code will run without it
APOLLO_GRAPH_REF=https://api.apollographql.com/graphs/invoice_app@current

# Auth0 ENV vars (Legacy - will be deprecated)
DOMAIN=
CLIENT_ID=
CLIENT_SECRET=
AUDIENCE=

# New OAuth 2.0 Authentication System
# AUTH_SYSTEM: Controls which authentication system to use
#   - "auth0": Use Auth0 only (legacy)
#   - "new": Use new OAuth system only
#   - "dual": Support both (default during migration)
AUTH_SYSTEM=dual

# JWT Configuration
# Generate RSA keys using: yarn tsx scripts/generate-rsa-keys.ts
JWT_PRIVATE_KEY=<base64-encoded-4096bit-RSA-private-key>
JWT_PUBLIC_KEY=<base64-encoded-4096bit-RSA-public-key>
JWT_ISSUER=http://localhost:8000
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# OAuth Provider Credentials (Phase 3)
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple Sign In
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email Configuration (for verification and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@localhost
FROM_NAME=Invoice App

# Frontend URLs (for email links)
FRONTEND_URL=http://localhost:5173
VERIFY_EMAIL_URL=http://localhost:5173/verify-email
RESET_PASSWORD_URL=http://localhost:5173/reset-password
