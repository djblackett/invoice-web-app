# Required: the single application PostgreSQL database. This example is LOCAL only.
# Start it with: docker compose -f docker-compose.dev.yml up -d db-dev
DATABASE_URL=postgresql://postgres:local-only@localhost:55432/invoices_dev
# On Fly/Neon, DATABASE_URL is pooled and DATABASE_URL_UNPOOLED is direct.
# Both must target the same database and require TLS. Local/CI needs no second URL.
# DATABASE_URL_UNPOOLED=...

# Required for a compiled release; never use test/CI/development in a public environment.
NODE_ENV=production
# Optional (default 8000).
PORT=8000
# Optional; one exact HTTP(S) browser origin (scheme/host/port), no path or list.
# Set explicitly for every release. This REPLACES defaults, it does not add to them.
# Unset in non-production: http://localhost:5173 and https://localhost:5173 only.
# Unset in production: https://djblackett.github.io (historical default).
# Invalid/empty values, null and wildcards fail startup; credentials require bounded origins.
# Browser E2E supplies its exact dynamically allocated frontend origin automatically.
CORS_ORIGIN=http://localhost:5173

# Demo-specific, opt-in. Auth0 users and demoId/USER share DATABASE_URL.
DEMO_MODE=false

# Auth0-specific: required for normal sign-in, optional for a demo-only local run.
# DOMAIN is the HTTPS issuer URL INCLUDING its trailing slash.
DOMAIN=
AUDIENCE=

# Development/test transport only: directory relative to src/server.ts.
# The default is ../certs. Empty disables local TLS; production always uses HTTP behind TLS ingress.
CERT_DIR=

# Optional Apollo production landing-page graph reference, not a URL or credential.
# APOLLO_GRAPH_REF=graph-id@variant

# No SECRET/CLIENT_SECRET/DEMO_DATABASE_URL/DEMO_ADMIN_TOKEN is used by this application.
# NODE_ENV=test/CI and /test-setup are private test/development paths, never release settings.
