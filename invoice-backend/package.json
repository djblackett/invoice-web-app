{
  "name": "invoice-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "prisma": {
    "seed": "node ./prisma/seed.mjs"
  },
  "scripts": {
    "test:unit": "vitest run tests/unit --reporter=default",
    "test:integration": "node scripts/test-integration.cjs",
    "coverage": "node scripts/test-integration.cjs --coverage",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "dev": "cross-env NODE_ENV=development ts-node-dev -r tsconfig-paths/register src/index.ts",
    "prod": "npm start",
    "lint": "eslint --config ./eslint.config.mjs ./src --max-warnings=0",
    "lint:fix": "eslint --config ./eslint.config.mjs --fix ./src",
    "format": "prettier --write .",
    "start": "cross-env NODE_ENV=production node dist/src/index.js",
    "generate": "graphql-codegen",
    "codegen": "graphql-codegen --config codegen.ts",
    "prisma-generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "migrate:deploy": "node scripts/migrate.cjs"
  },
  "author": "David Andrea",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/eslint-plugin-security": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "22.7.5",
    "@vitest/ui": "3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.13.0",
    "graphql-codegen-typescript-mock-data": "^4.1.0",
    "graphql-prettier": "^1.0.6",
    "inversify-dts": "^3.0.0",
    "node-mocks-http": "^1.14.1",
    "prettier": "^3.4.2",
    "supertest-graphql": "^1.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^8.17.0",
    "vitest": "3.2.7",
    "vitest-mock-extended": "^2.0.2"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@graphql-tools/schema": "^10.0.6",
    "@prisma/client": "6.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.13",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/ws": "^8.5.10",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.8",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "graphql": "^16.9.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^5.16.0",
    "inversify": "^6.0.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "prisma": "6.2.1",
    "reflect-metadata": "^0.2.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "winston": "3.3.1",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "resolutions": {
    "vite": "6.4.4",
    "lodash@npm:~4.17.0": "npm:4.18.1"
  }
}
