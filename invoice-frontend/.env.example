# frontend env vars here

# Playwright vars
TEST_LOGIN=
TEST_PASSWORD=
TEST_BASE_URL=https://localhost:5173/invoice-web-app/

# Path to https certificates
CERT_PATH=./certs

# TODO - Why is this here?
DATABASE_URL=postgresql://postgres:example@localhost:5432/db-test

# Authentication System Selection
# Options: "auth0" (default), "new" (self-hosted OAuth), "dual" (migration mode)
VITE_AUTH_SYSTEM=auth0

# Auth0 vars (only needed if VITE_AUTH_SYSTEM is "auth0" or "dual")
VITE_DOMAIN=
VITE_AUDIENCE=https://invoice-web-app/
VITE_CLIENT_ID=
VITE_SCOPE="openid profile email offline_access role"
VITE_REDIRECT_URI=https://localhost:5173/invoice-web-app/

# New OAuth System vars (only needed if VITE_AUTH_SYSTEM is "new" or "dual")
# Backend URL is automatically derived from VITE_BACKEND_URL
# OAuth callback URL: /auth/callback
