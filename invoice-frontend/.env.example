# Required public build-time API URL. Use the backend root for HTTP + WebSocket routing.
VITE_BACKEND_URL=http://localhost:8000
# Demo-specific opt-in; backend must independently set DEMO_MODE=true.
VITE_DEMO_MODE=false

# Public Auth0 SPA configuration, required only for normal sign-in.
# Frontend domain is the tenant hostname; backend DOMAIN is the full issuer URL.
VITE_DOMAIN=
VITE_CLIENT_ID=
VITE_AUDIENCE=
VITE_SCOPE="openid profile email offline_access role"
# Optional; defaults to window.location.origin + /invoice-web-app/.
VITE_REDIRECT_URI=

# All VITE_* values are public and embedded during build. NEVER put secrets here.
# No database URL, client secret, test account or saved login is needed by the frontend.
# DEV_HTTPS=false is an optional shell-only local Vite setting; production TLS belongs to ingress.
# E2E-only shell settings: PG_BIN, E2E_CHROMIUM_EXECUTABLE,
# E2E_FIREFOX_EXECUTABLE and E2E_BACKEND_REGRESSION (see README).
